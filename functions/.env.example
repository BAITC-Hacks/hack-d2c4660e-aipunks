# Non-secret configuration. OPENAI_API_KEY belongs in Secret Manager in production.
OPENAI_MODEL=gpt-6-luna
ASSISTANT_REGION=us-central1
ASSISTANT_CACHE_TTL_SECONDS=3600
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# Enable after configuring App Check in every client platform.
ASSISTANT_ENFORCE_APP_CHECK=false
# Local emulator defaults to memory. Set firestore to test distributed storage.
# ASSISTANT_STORAGE=firestore
