{
  "functions": [{
    "source": "functions",
    "codebase": "assistant",
    "ignore": ["node_modules", ".git", "*.log", ".secret.local", ".env*", "src/tests"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  }],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
