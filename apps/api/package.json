{
  "name": "event-match-local-api",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "db:import": "node --env-file-if-exists=.env src/import.mjs",
    "admin:create": "node --env-file-if-exists=.env src/admin-create.mjs",
    "admin:grant": "node --env-file-if-exists=.env src/admin-grant.mjs",
    "assistant:smoke": "node --env-file-if-exists=.env src/assistant-smoke.mjs --live",
    "db:seed": "node ../../scripts/seed_catalog.mjs && npm run db:import",
    "catalog:audit": "node ../../scripts/audit_catalog.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": { "openai": "^6.0.0", "zod": "^3.25.0" }
}
