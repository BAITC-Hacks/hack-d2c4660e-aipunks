# Copy to .env and set the secret locally. Never use a Flutter dart-define for it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Global local-demo ceiling, persisted in SQLite (cache hits do not count).
MAX_AI_CALLS_PER_DAY=100
# Required if HOST is not loopback. This is a local-demo token, not production auth.
LOCAL_API_TOKEN=
# Optional absolute path to Dart executable if it is not on PATH.
DART_BIN=
